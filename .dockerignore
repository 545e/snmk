# Version control
.git
.github
.gitignore

# Python cache and bytecode
__pycache__
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
env/
.venv/
ENV/

# Local database and persistent state
swa_data.db
*.db
*.sqlite
*.sqlite3

# Secrets and credentials -- never bake these into an image layer.
# The build context is the working directory, not the git tree, so a local
# .env would otherwise be copied into the image by "COPY . .".
.env
.env.*
!.env.example
.swa_master.key
*.pem
*.key
secrets/

# Logs and runtime outputs
*.log
logs/
report_*.json
scratch/
tmp/

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
